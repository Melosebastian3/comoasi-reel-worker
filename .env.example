PORT=8080
NODE_ENV=production
DATABASE_URL=postgresql://<comoasi_app>:<password>@<neon-host>/comoasi?sslmode=require
COMOASI_STUDIO_BASE=https://como-asi-studio-jjokns.v2.appdeploy.ai
# Isolation guard: never add HISTYRA/Supabase/video-factory credentials here.

# Native Publisher: server-side OAuth, encrypted tokens and automatic publishing.
SOCIAL_TOKEN_ENCRYPTION_KEY=<long-random-secret>
META_APP_ID=<meta-developer-app-id>
META_APP_SECRET=<meta-developer-app-secret>
TIKTOK_CLIENT_KEY=<tiktok-developer-client-key>
TIKTOK_CLIENT_SECRET=<tiktok-developer-client-secret>
TIKTOK_AUDITED=false
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
YOUTUBE_API_AUDITED=false
